{
  "name": "opencollective-rss",
  "version": "1.0.0",
  "description": "A lightweight TypeScript service to generate RSS feeds for updates from any Open Collective account, using GraphQL and Hono.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run turbo -- run dev:task --",
    "build": "npm run turbo -- run build:compile",
    "start": "node dist/index.js",
    "format": "npm run turbo -- run format:task --",
    "test": "npm run turbo -- run test:task --",
    "test:watch": "npm run turbo -- run test:watch:task --",
    "codegen": "npm run turbo -- run codegen:task --",
    "lint": "npm run turbo -- run lint:task --",
    "lint:fix": "npm run turbo -- run lint:fix:task --",
    "format:check": "npm run turbo -- run format:check:task --",
    "type:check": "npm run turbo -- run type:check:task --",
    "dev:environment": "npm run dev:task -- \"$OC_DEV_ENV_RSS\"",
    "turbo": "turbo --skip-infer --single-package --root-turbo-json=turbo.standalone.json",
    "build:compile": "tsc",
    "build:clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "dev:task": "tsx watch src/index.ts",
    "format:task": "prettier --write \"src/**/*.ts\"",
    "test:task": "vitest run",
    "test:watch:task": "vitest watch",
    "codegen:task": "graphql-codegen",
    "lint:task": "eslint .",
    "lint:fix:task": "eslint . --fix",
    "format:check:task": "prettier --check \"src/**/*.ts\"",
    "type:check:task": "tsc --noEmit"
  },
  "keywords": [
    "opencollective",
    "rss",
    "graphql",
    "hono"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "hono": "^4.12.25",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@types/node": "^25.9.3",
    "@types/rss": "^0.0.32",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9",
    "turbo": "2.11.7"
  },
  "packageManager": "npm@11.19.0"
}
