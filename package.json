{
  "name": "opencollective-rss",
  "version": "1.0.0",
  "description": "A lightweight TypeScript service to generate RSS feeds for updates from any Open Collective account, using GraphQL and Hono.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "codegen": "graphql-codegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "opencollective",
    "rss",
    "graphql",
    "hono"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "hono": "^4.12.25",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@types/node": "^25.9.3",
    "@types/rss": "^0.0.32",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  }
}
